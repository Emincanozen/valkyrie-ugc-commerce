# ==============================================================================
# MANDATORY CONFIGURATION
# ==============================================================================
# Your Anthropic Claude API Key - get yours at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY="You can put your API key here"

# ==============================================================================
# AGENT TEMPLATE LOCK
# ==============================================================================
# Locks the Aether Studio interface to Valkyrie (ecommerce agent)
OWNED_AGENT=ecommerce
NEXT_PUBLIC_OWNED_AGENT=ecommerce

# ==============================================================================
# OPTIONAL INTEGRATIONS & ADVANCED CONFIGURATION
# ==============================================================================
# Optional link to unlock additional agents (sales or upgrade page)
# NEXT_PUBLIC_UNLOCK_URL=

# Arcads AI Avatars & UGC Video Generation (can also be configured directly in-app)
# ARCADS_CLIENT_ID="You can put your API key here"
# ARCADS_CLIENT_SECRET="You can put your API key here"

# Optional web scraping & social intelligence
# APIFY_TOKEN="You can put your API key here"

# Optional image generation
# GEMINI_API_KEY="You can put your API key here"

# Optional Google / Gmail integration
# GOOGLE_CLIENT_ID="You can put your API key here"
# GOOGLE_CLIENT_SECRET="You can put your API key here"
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional Anthropic model overrides
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_OPUS=claude-opus-4-20250514
